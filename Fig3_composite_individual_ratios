# Figure 3: Physical vs in silico composite richness
#
# Main steps:
# - Restrict analysis to plots with 14 individual cores and a physical composite
# - Pool the 14 individual cores and rarefy the pool to 8,000 reads
# - Repeat in silico rarefaction 100 times and calculate mean richness per plot
# - Compare physical and in silico composites using a Gamma-log model
# - Plot the ratio of physical to in silico composite richness

library(dplyr)
library(ggplot2)
library(phyloseq)
library(vegan)
library(glmmTMB)
library(emmeans)
library(openxlsx)

sample_depth <- 8000
nrep <- 100
seed <- 1

phy <- readRDS("physeq16S_rarefied_8000.rds")

otu <- as(otu_table(phy), "matrix")
if (taxa_are_rows(phy)) otu <- t(otu)

meta <- data.frame(sample_data(phy), check.names = FALSE)
meta$Sample <- rownames(meta)
meta$Plot <- as.character(meta$VIP_Plot)
meta$Type <- factor(trimws(meta$Type), levels = c("Forest", "Grassland"))
meta$Exploratory <- factor(meta$Exploratory)


# Matched plots

matched_plots <- meta %>%
  group_by(Plot, Type, Exploratory) %>%
  summarise(
    n_individual = sum(Pooling == "N"),
    n_composite = sum(Pooling == "P"),
    .groups = "drop"
  ) %>%
  filter(n_individual == 14, n_composite >= 1)


# Physical and in silico composite richness

set.seed(seed)
results <- vector("list", nrow(matched_plots))

for (i in seq_len(nrow(matched_plots))) {

  pid <- matched_plots$Plot[i]

  ind <- meta$Sample[
    meta$Plot == pid & meta$Pooling == "N"
  ]

  physical <- meta$Sample[
    meta$Plot == pid & meta$Pooling == "P"
  ][1]

  pooled <- colSums(otu[ind, , drop = FALSE])

  synthetic_q0 <- replicate(
    nrep,
    sum(
      vegan::rrarefy(
        matrix(pooled, nrow = 1),
        sample = sample_depth
      ) > 0
    )
  )

  results[[i]] <- data.frame(
    Plot = pid,
    Type = matched_plots$Type[i],
    Exploratory = matched_plots$Exploratory[i],
    Synthetic_q0 = mean(synthetic_q0),
    Physical_q0 = sum(otu[physical, ] > 0)
  )
}

dat <- bind_rows(results) %>%
  mutate(
    Ratio = Physical_q0 / Synthetic_q0
  )


# Gamma-log model

model_data <- bind_rows(
  dat %>%
    transmute(
      Plot, Type, Exploratory,
      Method = "Physically composited",
      Richness = Physical_q0
    ),
  dat %>%
    transmute(
      Plot, Type, Exploratory,
      Method = "In silico composite",
      Richness = Synthetic_q0
    )
) %>%
  mutate(
    Method = factor(
      Method,
      levels = c("Physically composited", "In silico composite")
    )
  )

model <- glmmTMB(
  Richness ~ Method * Type + Exploratory + (1 | Plot),
  data = model_data,
  family = Gamma(link = "log")
)

emm <- emmeans(model, ~ Method | Type, type = "response")

model_results <- as.data.frame(
  summary(pairs(emm), type = "response")
)


# Ratio summary and bootstrap confidence intervals

set.seed(seed)

ratio_summary <- dat %>%
  group_by(Type) %>%
  group_modify(~ {

    boot <- replicate(
      2000,
      mean(sample(.x$Ratio, replace = TRUE))
    )

    data.frame(
      mean_ratio = mean(.x$Ratio),
      lower = quantile(boot, 0.025),
      upper = quantile(boot, 0.975)
    )
  }) %>%
  ungroup()

write.xlsx(
  list(
    Model_results = model_results,
    Ratio_summary = ratio_summary
  ),
  "Fig3_stats.xlsx",
  overwrite = TRUE
)


# Figure 3

cols <- c(
  Forest = "forestgreen",
  Grassland = "yellowgreen"
)

dark_cols <- c(
  Forest = "darkgreen",
  Grassland = "olivedrab"
)

p <- ggplot(dat, aes(Type, Ratio)) +
  geom_hline(
    yintercept = 1,
    linetype = "dashed",
    colour = "grey40"
  ) +
  geom_violin(
    aes(fill = Type),
    alpha = 0.25,
    width = 0.9,
    trim = TRUE
  ) +
  geom_jitter(
    aes(fill = Type),
    shape = 21,
    colour = "black",
    width = 0.12,
    size = 1.7,
    alpha = 0.8
  ) +
  geom_linerange(
    data = ratio_summary,
    aes(
      x = Type,
      ymin = lower,
      ymax = upper,
      colour = Type
    ),
    inherit.aes = FALSE,
    linewidth = 0.9
  ) +
  geom_point(
    data = ratio_summary,
    aes(
      x = Type,
      y = mean_ratio,
      fill = Type,
      colour = Type
    ),
    inherit.aes = FALSE,
    shape = 21,
    size = 3.2,
    stroke = 0.9
  ) +
  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = dark_cols, guide = "none") +
  labs(
    x = NULL,
    y = "Ratio of physically composited to\nin silico composite richness"
  ) +
  theme_bw(base_size = 13) +
  theme(
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 12),
    axis.title = element_text(size = 15)
  )

ggsave(
  "Fig3_physical_vs_insilico.png",
  p,
  width = 5,
  height = 4,
  dpi = 600,
  bg = "white"
)

ggsave(
  "Fig3_physical_vs_insilico.pdf",
  p,
  width = 5,
  height = 4,
  device = cairo_pdf,
  bg = "white"
)
