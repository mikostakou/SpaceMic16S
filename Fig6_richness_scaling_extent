# Figure 6: Sample-level vs observed plot-level richness across spatial extent
#
# Main steps:
# - Average repeated occurrences of the same core subset
# - Group observations into spatial extent classes
# - Average within Plot x SampleSize x ExtentBin
# - Fit Gamma GLMMs separately for each extent class
# - Generate proportionally weighted marginal predictions
# - Save Figure 6 and statistical summaries

library(dplyr)
library(ggplot2)
library(glmmTMB)
library(emmeans)
library(openxlsx)

options(contrasts = c("contr.sum", "contr.poly"))

raw <- readRDS("Sampling_Engel_100reps_updated.rds") %>%
  mutate(
    Type = factor(trimws(Type), levels = c("Grassland", "Forest")),
    Plot = factor(Plot),
    Exploratory = factor(Exploratory),
    SampleSize = as.integer(SampleSize)
  )

extent_bins <- c("0–12 m", "12–18 m", "18–36 m")


# Average repeated occurrences of the same core subset

base <- raw %>%
  filter(
    SampleSize > 1,
    MaxExtent_m > 0,
    Alpha_q0 > 0,
    Gamma_q0 > 0
  ) %>%
  group_by(
    Plot, Type, Exploratory, SampleSize,
    CoreIndices, MaxExtent_m
  ) %>%
  summarise(
    Alpha_q0 = mean(Alpha_q0, na.rm = TRUE),
    Gamma_q0 = mean(Gamma_q0, na.rm = TRUE),
    .groups = "drop"
  )


# Spatial extent classes

dat <- base %>%
  mutate(
    ExtentBin = cut(
      MaxExtent_m,
      breaks = c(0, 12, 18, 36),
      labels = extent_bins,
      include.lowest = TRUE
    )
  ) %>%
  filter(!is.na(ExtentBin)) %>%
  group_by(
    Plot, Type, Exploratory,
    SampleSize, ExtentBin
  ) %>%
  summarise(
    Alpha_q0 = mean(Alpha_q0, na.rm = TRUE),
    Gamma_q0 = mean(Gamma_q0, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    ExtentBin = factor(ExtentBin, levels = extent_bins),
    logAlpha = log(Alpha_q0),
    SampleSizeF = factor(SampleSize)
  )


# Models and predictions by extent class

run_bin <- function(d, bin) {

  d <- droplevels(d)
  two_types <- nlevels(d$Type) > 1

  form <- if (two_types) {
    Gamma_q0 ~ logAlpha * Type + SampleSizeF + Exploratory + (1 | Plot)
  } else {
    Gamma_q0 ~ logAlpha + SampleSizeF + Exploratory + (1 | Plot)
  }

  model <- glmmTMB(
    form,
    data = d,
    family = Gamma(link = "log")
  )

  ranges <- d %>%
    group_by(Type) %>%
    summarise(
      lo = quantile(Alpha_q0, 0.01),
      hi = quantile(Alpha_q0, 0.99),
      .groups = "drop"
    )

  x <- seq(
    min(ranges$lo),
    max(ranges$hi),
    length.out = 120
  )

  if (two_types) {

    pred <- emmeans(
      model,
      ~ Type | logAlpha,
      at = list(logAlpha = log(x)),
      nuisance = c("SampleSizeF", "Exploratory"),
      wt.nuis = "proportional",
      type = "response"
    ) %>%
      summary(infer = TRUE) %>%
      as.data.frame()

    trends <- emtrends(
      model,
      ~ Type,
      var = "logAlpha",
      nuisance = c("SampleSizeF", "Exploratory")
    )

    contrast <- as.data.frame(
      summary(pairs(trends), infer = TRUE)
    )

  } else {

    pred <- emmeans(
      model,
      ~ logAlpha,
      at = list(logAlpha = log(x)),
      nuisance = c("SampleSizeF", "Exploratory"),
      wt.nuis = "proportional",
      type = "response"
    ) %>%
      summary(infer = TRUE) %>%
      as.data.frame() %>%
      mutate(Type = as.character(unique(d$Type)))

    trends <- emtrends(
      model,
      ~ 1,
      var = "logAlpha",
      nuisance = c("SampleSizeF", "Exploratory")
    )

    contrast <- data.frame()
  }

  pred <- pred %>%
    mutate(
      Alpha_q0 = exp(logAlpha),
      ExtentBin = bin
    ) %>%
    left_join(ranges, by = "Type") %>%
    filter(Alpha_q0 >= lo, Alpha_q0 <= hi)

  slopes <- as.data.frame(
    summary(trends, infer = TRUE)
  )

  if (!two_types) {
    slopes$Type <- as.character(unique(d$Type))
  }

  slopes <- slopes %>%
    mutate(
      ExtentBin = bin,
      gain_per_doubling = exp(log(2) * logAlpha.trend)
    )

  if (nrow(contrast) > 0) {
    contrast$ExtentBin <- bin
  }

  list(
    model = model,
    pred = pred,
    slopes = slopes,
    contrast = contrast
  )
}

res <- lapply(
  extent_bins,
  function(x) run_bin(filter(dat, ExtentBin == x), x)
)

pred <- bind_rows(lapply(res, `[[`, "pred")) %>%
  mutate(
    Type = factor(Type, levels = c("Grassland", "Forest")),
    ExtentBin = factor(ExtentBin, levels = extent_bins)
  )

slopes <- bind_rows(lapply(res, `[[`, "slopes"))
contrasts <- bind_rows(lapply(res, `[[`, "contrast"))


# Save statistical summaries

write.xlsx(
  list(
    Slopes = slopes,
    Slope_contrasts = contrasts
  ),
  "Fig6_stats.xlsx",
  overwrite = TRUE
)


# Figure 6

point_cols <- c(
  Grassland = "yellowgreen",
  Forest = "forestgreen"
)

line_cols <- c(
  Grassland = "olivedrab",
  Forest = "darkgreen"
)

p <- ggplot(dat, aes(Alpha_q0, Gamma_q0)) +

  geom_point(
    aes(colour = Type),
    alpha = 0.3,
    size = 1.2
  ) +

  geom_ribbon(
    data = pred,
    aes(
      x = Alpha_q0,
      ymin = asymp.LCL,
      ymax = asymp.UCL,
      fill = Type
    ),
    inherit.aes = FALSE,
    alpha = 0.3,
    colour = NA
  ) +

  geom_line(
    data = filter(pred, Type == "Grassland"),
    aes(Alpha_q0, response),
    inherit.aes = FALSE,
    colour = line_cols["Grassland"],
    linewidth = 1.15
  ) +

  geom_line(
    data = filter(pred, Type == "Forest"),
    aes(Alpha_q0, response),
    inherit.aes = FALSE,
    colour = line_cols["Forest"],
    linewidth = 1.15
  ) +

  facet_grid(Type ~ ExtentBin, drop = FALSE) +

  scale_colour_manual(
    values = point_cols,
    guide = "none"
  ) +

  scale_fill_manual(
    values = point_cols,
    guide = "none"
  ) +

  labs(
    x = "Sample-level richness",
    y = "Observed plot-level richness"
  ) +

  theme_bw(base_size = 15) +
  theme(
    axis.title = element_text(size = 18),
    axis.text = element_text(size = 14),
    strip.text = element_text(size = 15, face = "bold"),
    strip.text.y = element_text(angle = -90),
    strip.background = element_rect(
      fill = "grey92",
      colour = "black"
    ),
    panel.grid.minor = element_blank()
  )


# Save Figure 6

ggsave(
  "Fig6.png",
  p,
  width = 11,
  height = 6.8,
  dpi = 600,
  bg = "white"
)

ggsave(
  "Fig6.pdf",
  p,
  width = 11,
  height = 6.8,
  device = cairo_pdf,
  bg = "white"
)
