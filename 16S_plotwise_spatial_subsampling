# 16S plot-wise spatial subsampling analysis
#
# This script analyzes rarefied 16S data across sampling effort and spatial extent.
#
# Main steps:
# - Subsample 1-14 individual soil cores per plot
# - Calculate Hill diversity (q0, q1, q2) and sample coverage
# - Standardize plot-level diversity to a fixed sequencing depth of 8,000 reads
# - Calculate maximum and mean pairwise spatial distances
# - Repeat random subsampling 100 times per sampling effort
# - Save sampling-design metrics for downstream analyses


library(phyloseq)
library(dplyr)
library(openxlsx)
library(betaC)
library(vegan)

ps <- readRDS("physeq16S_RAREFIED_8000.rds")

sizes <- 1:14
nrep <- 100
sample_depth <- 8000
seed <- 1


# Hill diversity functions

hill_q1 <- function(v) {
  v <- as.numeric(v)
  v <- v[v > 0]
  p <- v / sum(v)
  exp(-sum(p * log(p)))
}

hill_q2 <- function(v) {
  v <- as.numeric(v)
  v <- v[v > 0]
  p <- v / sum(v)
  1 / sum(p^2)
}

coverage_q0 <- function(v) {
  x <- as.numeric(betaC::coverage(as.numeric(v)))
  if (is.finite(x)) x else NA_real_
}


# Metadata

meta <- data.frame(
  sample_data(ps),
  stringsAsFactors = FALSE
)

meta$sfull <- rownames(meta)

meta_N <- meta[
  meta$Pooling == "N" & !is.na(meta$Pooling),
  ,
  drop = FALSE
]

meta_N$core_index <- as.integer(
  sub(".*_([0-9]+)$", "\\1", meta_N$Sample_ID)
)


# Fixed sampling coordinates

# Forest: 6 m spacing
xy_f <- data.frame(
  X = c(rep(0, 7), seq(-18, 18, by = 6)),
  Y = c(seq(-18, 18, by = 6), rep(0, 7))
)

# Grassland: 3 m spacing
xy_g <- data.frame(
  X = c(rep(0, 7), seq(-9, 9, by = 3)),
  Y = c(seq(-9, 9, by = 3), rep(0, 7))
)


# Plots to analyze

plots_ok <- meta_N %>%
  select(VIP_Plot, Type, Exploratory) %>%
  distinct() %>%
  filter(!is.na(VIP_Plot))


# Convert phyloseq OTU table to samples x ASVs matrix

otu <- as(otu_table(ps), "matrix")

if (taxa_are_rows(ps)) {
  otu <- t(otu)
}


# Random subsampling across sampling effort

set.seed(seed)

out <- vector(
  "list",
  nrow(plots_ok) * length(sizes) * nrep
)

idx <- 0L

for (i in seq_len(nrow(plots_ok))) {

  pid <- plots_ok$VIP_Plot[i]
  ptype <- plots_ok$Type[i]
  expl <- plots_ok$Exploratory[i]

  xyset <- if (ptype == "Forest") xy_f else xy_g

  matched <- rownames(meta_N)[meta_N$VIP_Plot == pid]
  otu_plot <- otu[matched, , drop = FALSE]

  for (k in sizes) {

    for (r in seq_len(nrep)) {

      sub_samp <- sample(rownames(otu_plot), k)
      comm <- otu_plot[sub_samp, , drop = FALSE]

      gamma <- colSums(comm)


      # q0: observed richness

      Alpha_q0 <- mean(rowSums(comm > 0))
      Gamma_q0 <- sum(gamma > 0)
      Beta_q0 <- Gamma_q0 / Alpha_q0


      # q1: exponential Shannon

      alpha_q1_values <- apply(comm, 1, hill_q1)
      Alpha_q1 <- exp(mean(log(alpha_q1_values)))
      Gamma_q1 <- hill_q1(gamma)
      Beta_q1 <- Gamma_q1 / Alpha_q1


      # q2: inverse Simpson

      row_totals <- rowSums(comm)
      p_comm <- sweep(comm, 1, row_totals, "/")

      Alpha_q2 <- 1 / mean(rowSums(p_comm^2))
      Gamma_q2 <- hill_q2(gamma)
      Beta_q2 <- Gamma_q2 / Alpha_q2


      # Sample coverage

      Alpha_SC_q0 <- mean(
        apply(comm, 1, coverage_q0),
        na.rm = TRUE
      )

      Gamma_SC_q0 <- coverage_q0(gamma)


      # Standardize pooled community to 8,000 reads

      gamma_rare <- as.numeric(
        vegan::rrarefy(
          matrix(gamma, nrow = 1),
          sample = sample_depth
        )
      )

      GammaRare_q0 <- sum(gamma_rare > 0)
      GammaRare_q1 <- hill_q1(gamma_rare)
      GammaRare_q2 <- hill_q2(gamma_rare)
      GammaRare_SC_q0 <- coverage_q0(gamma_rare)


      # Spatial extent

      coords_index <- meta_N$core_index[
        match(sub_samp, rownames(meta_N))
      ]

      if (length(coords_index) == 1) {

        MaxExtent <- 0
        MeanPairwiseDistance <- 0

      } else {

        coords_used <- xyset[
          coords_index,
          c("X", "Y"),
          drop = FALSE
        ]

        pairwise_distances <- as.numeric(dist(coords_used))

        MaxExtent <- max(pairwise_distances)
        MeanPairwiseDistance <- mean(pairwise_distances)
      }


      # Store results

      idx <- idx + 1L

      out[[idx]] <- data.frame(
        Plot = pid,
        Type = ptype,
        Exploratory = expl,
        SampleSize = k,
        Replicate = r,
        CoreIndices = paste(sort(coords_index), collapse = ","),
        Extent = MaxExtent,
        MaxExtent_m = MaxExtent,
        MeanPairwiseDistance_m = MeanPairwiseDistance,
        Alpha_q0 = Alpha_q0,
        Alpha_q1 = Alpha_q1,
        Alpha_q2 = Alpha_q2,
        Gamma_q0 = Gamma_q0,
        Gamma_q1 = Gamma_q1,
        Gamma_q2 = Gamma_q2,
        Beta_q0 = Beta_q0,
        Beta_q1 = Beta_q1,
        Beta_q2 = Beta_q2,
        Alpha_SC_q0 = Alpha_SC_q0,
        Gamma_SC_q0 = Gamma_SC_q0,
        rare_depth = sample_depth,
        GammaRare_q0 = GammaRare_q0,
        GammaRare_q1 = GammaRare_q1,
        GammaRare_q2 = GammaRare_q2,
        GammaRare_SC_q0 = GammaRare_SC_q0,
        stringsAsFactors = FALSE
      )
    }
  }
}


# Combine and save results

final_sampling <- bind_rows(out)

saveRDS(
  final_sampling,
  "spatial_subsampling.rds"
)

write.xlsx(
  final_sampling,
  "spatial_subsampling.xlsx",
  rowNames = FALSE
)
