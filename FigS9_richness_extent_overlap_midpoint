# Figure S9: Plot-level richness at the midpoint of overlapping
#            spatial extent range (N = 2 to 7)
#
# Model: Gamma GLMM, log-link: Gamma_q0 ~ log(Extent) * Type + (1|Plot)
#        fit separately per N; predictions at midpoint of
#        Type-specific overlapping Extent range


  library(dplyr)
  library(tidyr)
  library(ggplot2)
  library(glmmTMB)
  library(openxlsx)

setwd("path/to/your/16S/data")

# -- 1. Load data
sampling_data <- openxlsx::read.xlsx("16S_sampling_curves_individual.xlsx") %>%
  mutate(
    SampleSize = as.integer(SampleSize),
    Type       = factor(trimws(Type), levels = c("Forest", "Grassland")),
    Plot       = factor(Plot)
  ) %>%
  filter(SampleSize %in% 2:7) %>%
  drop_na(Extent, Gamma_q0, Type, SampleSize, Plot) %>%
  filter(is.finite(Extent), is.finite(Gamma_q0), Extent > 0, Gamma_q0 > 0) %>%
  mutate(SampleGroup = factor(paste0(SampleSize, " samples"),
                               levels = paste0(2:7, " samples")))

# -- 2. Plot settings
pal <- c("Forest" = "darkgreen", "Grassland" = "olivedrab4")

# -- 3. Fit GLMM per N and predict at midpoint of overlapping Extent range

## Helper: fit one model and return prediction at overlap midpoint
fit_slice_one <- function(dat, N) {
  dd <- dat %>%
    filter(SampleSize == N) %>%
    droplevels()

  if (nrow(dd) < 10)         return(NULL)
  if (nlevels(dd$Type) < 2)  return(NULL)

  lx <- log(dd$Extent)
  if (!all(is.finite(lx)) || sd(lx) == 0) return(NULL)

  # Center and scale log(Extent) within this N
  cen <- mean(lx)
  scl <- sd(lx)
  dd  <- dd %>% mutate(logExt_c = (lx - cen) / scl)

  m <- glmmTMB(
    Gamma_q0 ~ logExt_c * Type + (1 | Plot),
    data   = dd,
    family = Gamma(link = "log")
  )

  # Midpoint of overlapping Extent range between types
  rng <- dd %>%
    group_by(Type) %>%
    summarise(lo = min(Extent), hi = max(Extent), .groups = "drop")

  ov_min <- max(rng$lo)
  ov_max <- min(rng$hi)

  if (!is.finite(ov_min) || !is.finite(ov_max) || ov_min >= ov_max) return(NULL)

  M <- mean(c(ov_min, ov_max))

  nd <- data.frame(Type = levels(dd$Type)) %>%
    mutate(logExt_c = (log(M) - cen) / scl)

  pr <- predict(m, newdata = nd, type = "link", se.fit = TRUE, re.form = NA)

  tibble(
    SampleSize  = N,
    SampleGroup = factor(paste0(N, " samples"), levels = paste0(2:7, " samples")),
    Type        = factor(nd$Type, levels = levels(dd$Type)),
    Extent_mid  = M,
    Mean        = exp(pr$fit),
    Lower       = exp(pr$fit - 1.96 * pr$se.fit),
    Upper       = exp(pr$fit + 1.96 * pr$se.fit)
  )
}

slice_df <- bind_rows(Filter(Negate(is.null), lapply(2:7, fit_slice_one, dat = sampling_data)))

# -- 4. Build figure
p <- ggplot(slice_df, aes(x = SampleGroup, y = Mean, color = Type, group = Type)) +
  geom_linerange(
    aes(ymin = Lower, ymax = Upper),
    position = position_dodge(width = 0.45),
    linewidth = 1
  ) +
  geom_point(
    position = position_dodge(width = 0.45),
    size = 3
  ) +
  scale_color_manual(values = pal, name = NULL) +
  labs(x = "Sampling effort", y = "Plot-level richness") +
  theme_bw(base_size = 14) +
  theme(
    legend.position  = "bottom",
    legend.title     = element_blank(),
    strip.background = element_rect(fill = "white"),
    strip.text       = element_text(face = "bold"),
    axis.title.x     = element_text(size = 14),
    axis.title.y     = element_text(size = 14),
    axis.text.x      = element_text(angle = 0, hjust = 0.5)
  )

print(p)
ggsave("FigS9_richness_extent_overlap_midpoint.png", p,
       width = 7, height = 5.5, dpi = 600, bg = "white")
