# Figure 5: Richness and sample coverage vs spatial extent
#
# Main steps:
# - Estimate one spatial slope per plot while controlling for sampling effort
# - Compare plot-level slopes between ecosystems
# - Generate descriptive relationships for Figure 5
# - Save Figure 5 and statistical summaries

library(dplyr)
library(ggplot2)
library(emmeans)
library(car)
library(clubSandwich)
library(cowplot)
library(openxlsx)

options(contrasts = c("contr.sum", "contr.poly"))

raw <- readRDS("Sampling_Engel_100reps_updated.rds")

responses <- c(
  "Gamma_q0", "GammaRare_q0",
  "Gamma_SC_q0", "GammaRare_SC_q0"
)

dat <- raw %>%
  mutate(
    Type = factor(trimws(Type), levels = c("Grassland", "Forest")),
    Exploratory = factor(Exploratory),
    Plot = factor(Plot),
    SampleSize = as.integer(SampleSize),
    CoreKey = CoreIndices
  ) %>%
  group_by(
    Plot, Type, Exploratory, SampleSize,
    CoreKey, MaxExtent_m
  ) %>%
  summarise(
    across(all_of(responses), ~ mean(.x, na.rm = TRUE)),
    .groups = "drop"
  ) %>%
  filter(SampleSize > 1, MaxExtent_m > 0) %>%
  mutate(
    SampleSizeF = factor(SampleSize),
    logX = log(MaxExtent_m)
  )


# Estimate one spatial slope per plot

fit_plot_slope <- function(d, response, coverage = FALSE) {

  d$Y <- if (coverage) qlogis(d[[response]]) else log(d[[response]])

  fit <- lm(
    Y ~ logX + SampleSizeF,
    data = d
  )

  data.frame(
    Slope = coef(fit)["logX"]
  )
}

specs <- data.frame(
  Response = responses,
  Coverage = c(FALSE, FALSE, TRUE, TRUE)
)

plot_slopes <- bind_rows(
  lapply(seq_len(nrow(specs)), function(i) {

    dat %>%
      group_by(Plot, Type, Exploratory) %>%
      group_modify(
        ~ fit_plot_slope(
          .x,
          specs$Response[i],
          specs$Coverage[i]
        )
      ) %>%
      ungroup() %>%
      mutate(Response = specs$Response[i])
  })
)


# Compare spatial slopes between ecosystems

second_stage <- lapply(responses, function(response) {

  d <- filter(
    plot_slopes,
    Response == response,
    is.finite(Slope)
  )

  model <- lm(
    Slope ~ Type + Exploratory,
    data = d
  )

  emm <- emmeans(model, ~ Type)

  list(
    means = as.data.frame(summary(emm, infer = TRUE)) %>%
      mutate(Response = response),
    contrast = as.data.frame(summary(pairs(emm), infer = TRUE)) %>%
      mutate(Response = response),
    anova = {
      a <- as.data.frame(car::Anova(model, type = 3))
      data.frame(
        Response = response,
        Term = rownames(a),
        a,
        row.names = NULL
      )
    }
  )
})

names(second_stage) <- responses

slope_means <- bind_rows(lapply(second_stage, `[[`, "means"))
slope_contrasts <- bind_rows(lapply(second_stage, `[[`, "contrast"))
anova_stats <- bind_rows(lapply(second_stage, `[[`, "anova"))

write.xlsx(
  list(
    Plot_slopes = plot_slopes,
    Slope_means = slope_means,
    Ecosystem_contrasts = slope_contrasts,
    TypeIII = anova_stats
  ),
  "Fig5_stats.xlsx",
  overwrite = TRUE
)


# Descriptive models for figure curves

fit_vis <- function(response, coverage = FALSE) {

  x <- dat %>%
    filter(is.finite(.data[[response]]))

  if (coverage) {
    x <- filter(x, .data[[response]] > 0, .data[[response]] < 1)
  }

  x$Y <- if (coverage) qlogis(x[[response]]) else log(x[[response]])

  model <- lm(
    Y ~ logX * Type + Exploratory,
    data = x
  )

  attr(model, "dat") <- x
  model
}

m1 <- fit_vis("Gamma_q0")
m2 <- fit_vis("GammaRare_q0")
m3 <- fit_vis("Gamma_SC_q0", TRUE)
m4 <- fit_vis("GammaRare_SC_q0", TRUE)


# Predictions averaged across Exploratories

make_preds <- function(model, back = c("exp", "plogis"), n = 120) {

  back <- match.arg(back)
  x <- attr(model, "dat")
  b <- coef(model)

  V <- as.matrix(
    vcovCR(model, cluster = x$Plot, type = "CR2")
  )[names(b), names(b), drop = FALSE]

  crit <- qt(0.975, n_distinct(x$Plot) - 1)
  expl <- levels(x$Exploratory)

  ranges <- x %>%
    group_by(Type) %>%
    summarise(
      xmin = min(MaxExtent_m),
      xmax = max(MaxExtent_m),
      .groups = "drop"
    )

  grid <- bind_rows(
    lapply(seq_len(nrow(ranges)), function(i) {

      xs <- seq(
        ranges$xmin[i],
        ranges$xmax[i],
        length.out = n
      )

      expand.grid(
        Type = as.character(ranges$Type[i]),
        MaxExtent_m = xs,
        Exploratory = expl
      ) %>%
        mutate(
          pred_id = rep(seq_along(xs), times = length(expl)) +
            (i - 1) * n
        )
    })
  ) %>%
    mutate(
      Type = factor(Type, levels = levels(x$Type)),
      Exploratory = factor(Exploratory, levels = expl),
      logX = log(MaxExtent_m)
    )

  X <- model.matrix(delete.response(terms(model)), grid)
  X <- X[, names(b), drop = FALSE]

  Xbar <- rowsum(X, grid$pred_id, reorder = FALSE) / length(expl)

  meta <- grid %>%
    group_by(pred_id) %>%
    summarise(
      Type = first(Type),
      MaxExtent_m = first(MaxExtent_m),
      .groups = "drop"
    )

  eta <- drop(Xbar %*% b)
  se <- sqrt(rowSums((Xbar %*% V) * Xbar))
  f <- if (back == "exp") exp else plogis

  meta %>%
    mutate(
      estimate = f(eta),
      lower = f(eta - crit * se),
      upper = f(eta + crit * se)
    )
}

p1 <- make_preds(m1, "exp")
p2 <- make_preds(m2, "exp")
p3 <- make_preds(m3, "plogis")
p4 <- make_preds(m4, "plogis")


# Figure settings

point_cols <- c(
  Grassland = "yellowgreen",
  Forest = "green4"
)

line_cols <- c(
  Grassland = "olivedrab",
  Forest = "darkgreen"
)

theme_fig <- theme_bw(base_size = 13) +
  theme(
    panel.grid.major = element_line(colour = "grey90", linewidth = 0.5),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 12),
    axis.title = element_text(size = 15),
    legend.position = "none",
    aspect.ratio = 1
  )

make_panel <- function(response, pred, ylim, breaks, ylab) {

  ggplot() +
    geom_ribbon(
      data = pred,
      aes(MaxExtent_m, ymin = lower, ymax = upper, fill = Type),
      alpha = 0.30,
      colour = NA
    ) +
    geom_point(
      data = filter(dat, Type == "Grassland"),
      aes(MaxExtent_m, .data[[response]]),
      colour = point_cols["Grassland"],
      alpha = 0.05,
      size = 0.9
    ) +
    geom_point(
      data = filter(dat, Type == "Forest"),
      aes(MaxExtent_m, .data[[response]]),
      colour = point_cols["Forest"],
      alpha = 0.05,
      size = 0.9
    ) +
    geom_line(
      data = filter(pred, Type == "Grassland"),
      aes(MaxExtent_m, estimate),
      colour = line_cols["Grassland"],
      linewidth = 1.15
    ) +
    geom_line(
      data = filter(pred, Type == "Forest"),
      aes(MaxExtent_m, estimate),
      colour = line_cols["Forest"],
      linewidth = 1.15
    ) +
    scale_fill_manual(values = point_cols, guide = "none") +
    scale_x_continuous(
      limits = c(0, 36),
      breaks = c(0, 6, 12, 18, 24, 30, 36)
    ) +
    scale_y_continuous(breaks = breaks) +
    coord_cartesian(ylim = ylim) +
    labs(
      x = "Maximum pairwise distance (m)",
      y = ylab
    ) +
    theme_fig
}


