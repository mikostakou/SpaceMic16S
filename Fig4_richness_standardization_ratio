# Figure 4: Standardized / observed plot-level richness ratio
#
# Main steps:
# - Calculate plot-level richness ratios at 3, 6 and 12 cores
# - Test ecosystem and sampling-effort effects using a Beta GLMM
# - Estimate trends with increasing sampling effort
# - Generate Figure 4 and save statistical summaries

library(dplyr)
library(ggplot2)
library(glmmTMB)
library(emmeans)
library(car)
library(openxlsx)

options(contrasts = c("contr.sum", "contr.poly"))

raw <- readRDS("Sampling_Engel_100reps_updated.rds")


# Prepare plot-level data

dat <- raw %>%
  mutate(
    Type = factor(trimws(Type), levels = c("Grassland", "Forest")),
    Plot = factor(Plot),
    Exploratory = factor(Exploratory),
    SampleSize = as.integer(SampleSize),
    Ratio_q0 = GammaRare_q0 / Gamma_q0
  ) %>%
  filter(
    SampleSize %in% c(3, 6, 12),
    is.finite(Ratio_q0),
    Ratio_q0 > 0
  ) %>%
  group_by(Plot, Type, Exploratory, SampleSize) %>%
  summarise(
    Ratio_q0 = mean(Ratio_q0, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    SampleSizeF = factor(SampleSize, levels = c(3, 6, 12)),
    log2N = log2(SampleSize)
  )


# Model sampling-effort classes

m <- glmmTMB(
  Ratio_q0 ~ SampleSizeF * Type + Exploratory + (1 | Plot),
  data = dat,
  family = beta_family(link = "logit")
)

pred <- as.data.frame(
  summary(
    emmeans(m, ~ SampleSizeF | Type, type = "response"),
    infer = TRUE
  )
)

type_contrasts <- as.data.frame(
  summary(
    pairs(
      emmeans(m, ~ Type | SampleSizeF),
      adjust = "holm"
    ),
    infer = TRUE
  )
)

type3 <- as.data.frame(car::Anova(m, type = 3))
type3$Term <- rownames(type3)
rownames(type3) <- NULL


# Trend with sampling effort

m_trend <- glmmTMB(
  Ratio_q0 ~ log2N * Type + Exploratory + (1 | Plot),
  data = dat,
  family = beta_family(link = "logit")
)

trends <- emtrends(m_trend, ~ Type, var = "log2N")

slopes <- as.data.frame(
  summary(trends, infer = TRUE)
)

slope_contrast <- as.data.frame(
  summary(pairs(trends), infer = TRUE)
)


# Save statistics

write.xlsx(
  list(
    Predictions = pred,
    Type_contrasts = type_contrasts,
    Trend_slopes = slopes,
    Trend_contrast = slope_contrast,
    TypeIII = type3
  ),
  "Fig4_stats.xlsx",
  overwrite = TRUE
)


# Figure settings

cols <- c(
  Grassland = "yellowgreen",
  Forest = "forestgreen"
)

dark_cols <- c(
  Grassland = "olivedrab",
  Forest = "darkgreen"
)

set.seed(1)

p <- ggplot(dat, aes(SampleSizeF, Ratio_q0)) +

  geom_jitter(
    data = filter(dat, Type == "Grassland"),
    colour = cols["Grassland"],
    size = 1.6,
    alpha = 0.3,
    width = 0.10
  ) +

  geom_jitter(
    data = filter(dat, Type == "Forest"),
    colour = cols["Forest"],
    size = 1.6,
    alpha = 0.3,
    width = 0.10
  ) +

  geom_linerange(
    data = pred,
    aes(
      x = SampleSizeF,
      ymin = asymp.LCL,
      ymax = asymp.UCL,
      colour = Type
    ),
    inherit.aes = FALSE,
    linewidth = 0.9
  ) +

  geom_point(
    data = pred,
    aes(
      x = SampleSizeF,
      y = response,
      fill = Type,
      colour = Type
    ),
    inherit.aes = FALSE,
    shape = 21,
    size = 3.2,
    stroke = 0.9
  ) +

  facet_wrap(~ Type, nrow = 1) +

  scale_fill_manual(values = cols, guide = "none") +
  scale_colour_manual(values = dark_cols, name = NULL) +

  labs(
    x = "Sampling effort",
    y = "Standardized / observed\nplot-level richness ratio"
  ) +

  theme_bw(base_size = 14) +
  theme(
    strip.text = element_blank(),
    strip.background = element_blank(),
    legend.position = "bottom",
    axis.text = element_text(size = 14),
    panel.grid.minor = element_blank()
  )

ggsave(
  "Fig4_richness_standardization_ratio.png",
  p,
  width = 8,
  height = 5,
  dpi = 600,
  bg = "white"
)

ggsave(
  "Fig4_richness_standardization_ratio.pdf",
  p,
  width = 8,
  height = 5,
  device = cairo_pdf,
  bg = "white"
)
