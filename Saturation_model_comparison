# Table S6: Model comparison for richness responses
# to sampling effort and spatial extent

library(dplyr)
library(glmmTMB)
library(openxlsx)

raw <- readRDS("spatial_subsampling.rds") %>%
  mutate(
    SampleSize = as.integer(SampleSize),
    Type = factor(trimws(Type), levels = c("Grassland", "Forest")),
    Exploratory = factor(Exploratory),
    Plot = factor(Plot)
  )


# Sampling effort

effort_dat <- raw %>%
  group_by(Plot, Type, Exploratory, SampleSize) %>%
  summarise(
    Gamma_q0 = mean(Gamma_q0, na.rm = TRUE),
    GammaRare_q0 = mean(GammaRare_q0, na.rm = TRUE),
    .groups = "drop"
  )

compare_effort <- function(response) {

  formulas <- list(
    "Log-linear" = as.formula(
      paste0(
        response,
        " ~ log(SampleSize) * Type + Exploratory + (1 | Plot)"
      )
    ),
    "Square root" = as.formula(
      paste0(
        response,
        " ~ sqrt(SampleSize) * Type + Exploratory + (1 | Plot)"
      )
    ),
    "Asymptotic" = as.formula(
      paste0(
        response,
        " ~ I(SampleSize / (SampleSize + 1)) * Type + Exploratory + (1 | Plot)"
      )
    ),
    "Linear" = as.formula(
      paste0(
        response,
        " ~ SampleSize * Type + Exploratory + (1 | Plot)"
      )
    )
  )

  models <- lapply(
    formulas,
    function(f)
      glmmTMB(
        f,
        data = effort_dat,
        family = Gamma(link = "log")
      )
  )

  aic <- sapply(models, AIC)

  data.frame(
    Response = response,
    Predictor = "Sampling effort",
    Model = names(models),
    AIC = aic,
    DeltaAIC = aic - min(aic),
    row.names = NULL
  ) %>%
    arrange(DeltaAIC)
}


# Spatial extent

extent_dat <- raw %>%
  filter(
    SampleSize > 1,
    MaxExtent > 0,
    Gamma_q0 > 0,
    GammaRare_q0 > 0
  ) %>%
  group_by(
    Plot, Type, Exploratory,
    SampleSize, CoreIndices, MaxExtent
  ) %>%
  summarise(
    Gamma_q0 = mean(Gamma_q0, na.rm = TRUE),
    GammaRare_q0 = mean(GammaRare_q0, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    SampleSizeF = factor(SampleSize)
  )

compare_extent <- function(response) {

  formulas <- list(
    "Log-linear" = as.formula(
      paste0(
        response,
        " ~ log(MaxExtent) * Type + SampleSizeF + Exploratory + (1 | Plot)"
      )
    ),
    "Square root" = as.formula(
      paste0(
        response,
        " ~ sqrt(MaxExtent) * Type + SampleSizeF + Exploratory + (1 | Plot)"
      )
    ),
    "Asymptotic" = as.formula(
      paste0(
        response,
        " ~ I(MaxExtent / (MaxExtent + 1)) * Type + SampleSizeF + Exploratory + (1 | Plot)"
      )
    ),
    "Linear" = as.formula(
      paste0(
        response,
        " ~ MaxExtent * Type + SampleSizeF + Exploratory + (1 | Plot)"
      )
    )
  )

  models <- lapply(
    formulas,
    function(f)
      glmmTMB(
        f,
        data = extent_dat,
        family = Gamma(link = "log")
      )
  )

  aic <- sapply(models, AIC)

  data.frame(
    Response = response,
    Predictor = "Spatial extent",
    Model = names(models),
    AIC = aic,
    DeltaAIC = aic - min(aic),
    row.names = NULL
  ) %>%
    arrange(DeltaAIC)
}


# Table S6

table_s6 <- bind_rows(
  compare_effort("Gamma_q0"),
  compare_effort("GammaRare_q0"),
  compare_extent("Gamma_q0"),
  compare_extent("GammaRare_q0")
)

write.xlsx(
  table_s6,
  "TableS6_saturation_model_comparison.xlsx",
  overwrite = TRUE
)
