# Figure 1: Richness and sample coverage vs sampling effort
#
# Main steps:
# - Average repeated simulations within Plot x SampleSize for inference
# - Fit richness and sample-coverage models
# - Generate model predictions
# - Plot unique core subsets and model predictions
# - Save Figure 1 and statistical summaries

library(dplyr)
library(ggplot2)
library(glmmTMB)
library(emmeans)
library(performance)
library(car)
library(cowplot)
library(openxlsx)

options(contrasts = c("contr.sum", "contr.poly"))

raw <- readRDS("Sampling_Engel_100reps_updated.rds")
type_levels <- c("Grassland", "Forest")

# Prepare model data

dat <- raw %>%
  mutate(
    Type = factor(trimws(Type), levels = type_levels),
    Exploratory = factor(Exploratory),
    Plot = factor(Plot),
    SampleSize = as.integer(SampleSize)
  ) %>%
  group_by(Plot, Type, Exploratory, SampleSize) %>%
  summarise(
    across(c(Gamma_q0, GammaRare_q0,
             Gamma_SC_q0, GammaRare_SC_q0),
           ~ mean(.x, na.rm = TRUE)),
    .groups = "drop"
  ) %>%
  mutate(logN = log(SampleSize))


# Fit models

m_q0 <- glmmTMB(
  Gamma_q0 ~ logN * Type + Exploratory + (1 | Plot),
  family = Gamma(link = "log"), data = dat
)

m_q0_8k <- glmmTMB(
  GammaRare_q0 ~ logN * Type + Exploratory + (1 | Plot),
  family = Gamma(link = "log"), data = dat
)

m_cov <- glmmTMB(
  Gamma_SC_q0 ~ SampleSize * Type + Exploratory + (1 | Plot),
  family = beta_family(link = "logit"), data = dat
)

m_cov_8k <- glmmTMB(
  GammaRare_SC_q0 ~ SampleSize * Type + Exploratory + (1 | Plot),
  family = beta_family(link = "logit"), data = dat
)

models <- list(
  Gamma_q0 = m_q0,
  GammaRare_q0 = m_q0_8k,
  Coverage = m_cov,
  Coverage_8k = m_cov_8k
)

saveRDS(models, "Fig1_models.rds")


# Statistical summaries

get_trends <- function(model, metric, var) {
  tr <- emtrends(model, ~ Type, var = var)

  list(
    slopes = as.data.frame(summary(tr, infer = TRUE)) %>%
      mutate(Metric = metric),
    contrasts = as.data.frame(summary(pairs(tr), infer = TRUE)) %>%
      mutate(Metric = metric)
  )
}

s1 <- get_trends(m_q0, "Gamma_q0", "logN")
s2 <- get_trends(m_q0_8k, "GammaRare_q0", "logN")
s3 <- get_trends(m_cov, "Coverage", "SampleSize")
s4 <- get_trends(m_cov_8k, "Coverage_8k", "SampleSize")

slopes <- bind_rows(s1$slopes, s2$slopes, s3$slopes, s4$slopes)
contrasts <- bind_rows(s1$contrasts, s2$contrasts, s3$contrasts, s4$contrasts)

anova_stats <- bind_rows(lapply(names(models), function(x) {
  a <- as.data.frame(car::Anova(models[[x]], type = 3))
  data.frame(Metric = x, Effect = rownames(a), a, row.names = NULL)
}))

r2_stats <- bind_rows(lapply(names(models), function(x) {
  r <- performance::r2(models[[x]])
  data.frame(
    Metric = x,
    R2_marginal = as.numeric(r$R2_marginal),
    R2_conditional = as.numeric(r$R2_conditional)
  )
}))

write.xlsx(
  list(
    Slopes = slopes,
    Slope_contrasts = contrasts,
    ANOVA = anova_stats,
    R2 = r2_stats
  ),
  "Fig1_stats.xlsx",
  overwrite = TRUE
)


# Model predictions

make_preds <- function(model, var) {

  if (var == "logN") {
    x <- emmeans(
      model, ~ Type | logN,
      at = list(logN = log(1:14)),
      type = "response"
    )
  } else {
    x <- emmeans(
      model, ~ Type | SampleSize,
      at = list(SampleSize = 1:14),
      type = "response"
    )
  }

  x <- as.data.frame(summary(x, type = "response"))

  data.frame(
    Type = x$Type,
    SampleSize = if (var == "logN") round(exp(x$logN)) else x$SampleSize,
    Mean = x$response,
    Lower = x$asymp.LCL,
    Upper = x$asymp.UCL
  )
}

pred_q0 <- make_preds(m_q0, "logN")
pred_q0_8k <- make_preds(m_q0_8k, "logN")
pred_cov <- make_preds(m_cov, "SampleSize")
pred_cov_8k <- make_preds(m_cov_8k, "SampleSize")


# Unique core subsets for plotting

points <- raw %>%
  mutate(
    Type = factor(trimws(Type), levels = type_levels),
    SampleSize = as.integer(SampleSize)
  ) %>%
  group_by(Plot, Type, Exploratory, SampleSize, CoreIndices) %>%
  summarise(
    across(c(Gamma_q0, GammaRare_q0,
             Gamma_SC_q0, GammaRare_SC_q0),
           ~ mean(.x, na.rm = TRUE)),
    .groups = "drop"
  )


# Figure settings

point_cols <- c(Grassland = "yellowgreen", Forest = "green4")
line_cols <- c(Grassland = "olivedrab", Forest = "darkgreen")

base_theme <- theme_bw(base_size = 13) +
  theme(
    panel.grid.major = element_line(colour = "grey90", linewidth = 0.5),
    panel.grid.minor = element_blank(),
    axis.text = element_text(size = 12),
    axis.title = element_text(size = 15),
    legend.position = "none",
    aspect.ratio = 1
  )

make_panel <- function(yvar, pred, ylab, ylim = NULL) {

  p <- ggplot() +
    geom_ribbon(
      data = pred,
      aes(SampleSize, ymin = Lower, ymax = Upper, fill = Type),
      alpha = 0.25, colour = NA
    ) +
    geom_point(
      data = points,
      aes(SampleSize, .data[[yvar]], colour = Type),
      alpha = 0.035, size = 1.1,
      position = position_jitter(width = 0.08, height = 0, seed = 1)
    ) +
    geom_line(
      data = filter(pred, Type == "Grassland"),
      aes(SampleSize, Mean),
      colour = line_cols["Grassland"], linewidth = 1.15
    ) +
    geom_line(
      data = filter(pred, Type == "Forest"),
      aes(SampleSize, Mean),
      colour = line_cols["Forest"], linewidth = 1.15
    ) +
    scale_colour_manual(values = point_cols, guide = "none") +
    scale_fill_manual(values = point_cols, guide = "none") +
    scale_x_continuous(breaks = c(1, 3, 5, 7, 9, 11, 14)) +
    labs(x = "Sampling effort", y = ylab) +
    base_theme

  if (!is.null(ylim)) p <- p + coord_cartesian(ylim = ylim)
  p
}


# Panels

rich_y <- range(
  c(points$Gamma_q0, points$GammaRare_q0,
    pred_q0$Lower, pred_q0$Upper,
    pred_q0_8k$Lower, pred_q0_8k$Upper),
  na.rm = TRUE
)

cov_y <- range(
  c(points$Gamma_SC_q0, points$GammaRare_SC_q0),
  na.rm = TRUE
)

pA <- make_panel("Gamma_q0", pred_q0,
                 "Observed plot-level richness", rich_y)

pB <- make_panel("GammaRare_q0", pred_q0_8k,
                 "Std. observed plot-level richness", rich_y)

pC <- make_panel("Gamma_SC_q0", pred_cov,
                 "Plot-level sample coverage", c(cov_y[1], 1.01))

pD <- make_panel("GammaRare_SC_q0", pred_cov_8k,
                 "Std. plot-level sample coverage", c(cov_y[1], 1.01))


# Assemble figure

top <- plot_grid(
  pA, pB, labels = c("a", "b"),
  label_size = 18, align = "hv", axis = "tblr"
)

bottom <- plot_grid(
  pC, pD, labels = c("c", "d"),
  label_size = 18, align = "hv", axis = "tblr"
)

legend_plot <- ggplot(
  pred_q0,
  aes(SampleSize, Mean, colour = Type)
) +
  geom_line(linewidth = 1.2) +
  scale_colour_manual(values = line_cols, name = NULL) +
  theme_void() +
  theme(
    legend.position = "bottom",
    legend.text = element_text(size = 13)
  )

fig1 <- plot_grid(
  top,
  bottom,
  get_legend(legend_plot),
  ncol = 1,
  rel_heights = c(1, 1, 0.08)
)

ggsave(
  "Fig1_sampling_effort.png",
  fig1,
  width = 10, height = 10, dpi = 600, bg = "white"
)

ggsave(
  "Fig1_sampling_effort.pdf",
  fig1,
  width = 10, height = 10,
  device = cairo_pdf, bg = "white"
)
